 "entries": [
  {
   "id": "010396",
   "fmt": "plain",
   "jp": "どうしたどうした!   戦いはこの俺に任せた方がいいんじゃねぇのか?{end}",
   "en": "",
   "max": 70,
   "ptr": [
    "p16 010332"
   ]
  },
  {
   "id": "0103DC",
   "fmt": "plain",
   "jp": "敵はどいつか知らねえがこの孟閣様にかかりゃあ、あの世行きよ!{end}",
   "en": "",
   "max": 62,
   "ptr": [
    "p16 010334"
   ]
  },
  {
   "id": "01041A",
   "fmt": "plain",
   "jp": "命知らずの鐘士元艦隊参上!{end}",
   "en": "",
   "max": 28,
   "ptr": [
    "p16 010336"
   ]
  },
  {
   "id": "010436",
   "fmt": "plain",
   "jp": "おおっ?やってるな?  俺達も入れてもらうぜ!{end}",
   "en": "",
   "max": 48,
   "ptr": [
    "p16 010338"
   ]
  },
  {
   "id": "010466",
   "fmt": "plain",
   "jp": "敵は近けぇぜ、野郎ども ぬかるんじゃあねえぞ!{end}",
   "en": "",
   "max": 48,
   "ptr": [
    "p16 01033A"
   ]
  },
  {
   "id": "010496",
   "fmt": "plain",
   "jp": "どけどけどけ〜!この項武様が、てがらをもらいに参上したぜえっ!{end}",
   "en": "",
   "max": 64,
   "ptr": [
    "p16 01033C"
   ]
  },
  {
   "id": "0104D6",
   "fmt": "plain",
   "jp": "やはり俺の考えた通り、常道だけでは難しいようだな。{end}",
   "en": "",
   "max": 52,
   "ptr": [
    "p16 01033E"
   ]
  },
  {
   "id": "01050A",
   "fmt": "plain",
   "jp": "えぇ～、コホン…。どなたかこの三楽斎をお呼びですかな?{end}",
   "en": "",
   "max": 56,
   "ptr": [
    "p16 010340"
   ]
  },
  {
   "id": "010542",
   "fmt": "plain",
   "jp": "わ、私にだって皆さんのお役に立つ事くらいできますから…。{end}",
   "en": "",
   "max": 58,
   "ptr": [
    "p16 010342"
   ]
  },
  {
   "id": "01057C",
   "fmt": "plain",
   "jp": "私もただ見ている訳にはまいりません。皆さんとともに戦います!{end}",
   "en": "",
   "max": 62,
   "ptr": [
    "p16 010344"
   ]
  },
  {
   "id": "0105BA",
   "fmt": "plain",
   "jp": "何やってんねんしっかりしぃや!うちが来たからにはようしゃせぇへんで!{end}",
   "en": "",
   "max": 70,
   "ptr": [
    "p16 010346"
   ]
  },
  {
   "id": "010600",
   "fmt": "plain",
   "jp": "ど〜した{FFFE}!こんな連中にいつまでももたついてんじゃねぇっ!{end}",
